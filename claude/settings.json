{
  "env": {
    "CLAUDE_CODE_ENABLE_AUTO_MODE": "1"
  },
  "permissions": {
    "allow": [
      "mcp__incident_io__*",
      "Skill(incident)"
    ]
  },
  "model": "opus[1m]",
  "hooks": {
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "sh $HOME/.claude/notify.sh"
          }
        ]
      }
    ]
  },
  "preferredNotifChannel": "notifications_disabled",
  "statusLine": {
    "type": "command",
    "command": "sh $HOME/.claude/statusline-command.sh"
  },
  "effortLevel": "medium",
  "theme": "auto"
}
